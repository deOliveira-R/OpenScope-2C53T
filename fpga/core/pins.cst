// FNIRSI 2C53T, GW1N-UV2QN48C7/I6: pin constraints of the capture core.
// Pad settings: LVCMOS33, keeper on inputs, 16 mA on the ADC clocks, 8 mA to the MCU (the same electrical settings the
// factory design uses), with ONE deliberate difference: PCI_CLAMP=OFF on every input. With the clamps on, the ADC
// outputs and the MCU's SPI lines keep the FPGA alive through the clamp diodes when the MCU switches its supply off
// (PC6), and the FPGA cannot be reloaded without a power cycle. Every design for this board must keep the clamps off.
// Roles: [V] proven on the unit, [?] open.
IO_LOC "clk25"    16; IO_PORT "clk25"    IO_TYPE=LVCMOS33 PULL_MODE=KEEPER PCI_CLAMP=OFF;            // [V] 25 MHz, PLL reference
IO_LOC "chb_clk" 17; IO_PORT "chb_clk" IO_TYPE=LVCMOS33 PULL_MODE=KEEPER DRIVE=16;  // [V] clocks converter B only
IO_LOC "cha_clk" 47; IO_PORT "cha_clk" IO_TYPE=LVCMOS33 PULL_MODE=KEEPER DRIVE=16;  // [V] clocks converter A only
// converter B (pins 18..27), 8 IDDRC. [V] bit order measured with a 50 kHz sine at three ranges.
IO_LOC "chb_d[7]" 18; IO_LOC "chb_d[6]" 19; IO_LOC "chb_d[5]" 20; IO_LOC "chb_d[4]" 21;
IO_LOC "chb_d[3]" 22; IO_LOC "chb_d[2]" 23; IO_LOC "chb_d[1]" 24; IO_LOC "chb_d[0]" 27;
// converter A (pins 39..46), 8 IDDRC. [V] bit order measured the same way.
IO_LOC "cha_d[7]" 46; IO_LOC "cha_d[6]" 45; IO_LOC "cha_d[5]" 44; IO_LOC "cha_d[4]" 43;
IO_LOC "cha_d[3]" 42; IO_LOC "cha_d[2]" 41; IO_LOC "cha_d[1]" 40; IO_LOC "cha_d[0]" 39;
IO_PORT "chb_d[0]" IO_TYPE=LVCMOS33 PULL_MODE=KEEPER PCI_CLAMP=OFF; IO_PORT "chb_d[1]" IO_TYPE=LVCMOS33 PULL_MODE=KEEPER PCI_CLAMP=OFF;
IO_PORT "chb_d[2]" IO_TYPE=LVCMOS33 PULL_MODE=KEEPER PCI_CLAMP=OFF; IO_PORT "chb_d[3]" IO_TYPE=LVCMOS33 PULL_MODE=KEEPER PCI_CLAMP=OFF;
IO_PORT "chb_d[4]" IO_TYPE=LVCMOS33 PULL_MODE=KEEPER PCI_CLAMP=OFF; IO_PORT "chb_d[5]" IO_TYPE=LVCMOS33 PULL_MODE=KEEPER PCI_CLAMP=OFF;
IO_PORT "chb_d[6]" IO_TYPE=LVCMOS33 PULL_MODE=KEEPER PCI_CLAMP=OFF; IO_PORT "chb_d[7]" IO_TYPE=LVCMOS33 PULL_MODE=KEEPER PCI_CLAMP=OFF;
IO_PORT "cha_d[0]" IO_TYPE=LVCMOS33 PULL_MODE=KEEPER PCI_CLAMP=OFF; IO_PORT "cha_d[1]" IO_TYPE=LVCMOS33 PULL_MODE=KEEPER PCI_CLAMP=OFF;
IO_PORT "cha_d[2]" IO_TYPE=LVCMOS33 PULL_MODE=KEEPER PCI_CLAMP=OFF; IO_PORT "cha_d[3]" IO_TYPE=LVCMOS33 PULL_MODE=KEEPER PCI_CLAMP=OFF;
IO_PORT "cha_d[4]" IO_TYPE=LVCMOS33 PULL_MODE=KEEPER PCI_CLAMP=OFF; IO_PORT "cha_d[5]" IO_TYPE=LVCMOS33 PULL_MODE=KEEPER PCI_CLAMP=OFF;
IO_PORT "cha_d[6]" IO_TYPE=LVCMOS33 PULL_MODE=KEEPER PCI_CLAMP=OFF; IO_PORT "cha_d[7]" IO_TYPE=LVCMOS33 PULL_MODE=KEEPER PCI_CLAMP=OFF;
IO_LOC "spi_miso" 28; IO_PORT "spi_miso" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;       // [V] to PB4
IO_LOC "spi_sclk" 29; IO_PORT "spi_sclk" IO_TYPE=LVCMOS33 PULL_MODE=KEEPER PCI_CLAMP=OFF;             // [V] from PB3
IO_LOC "spi_cs_n" 34; IO_PORT "spi_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=KEEPER PCI_CLAMP=OFF;             // [V] from PB6
IO_LOC "spi_mosi" 35; IO_PORT "spi_mosi" IO_TYPE=LVCMOS33 PULL_MODE=KEEPER PCI_CLAMP=OFF;             // [V] from PB5
IO_LOC "ready_n"  38; IO_PORT "ready_n"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;       // [V] goes to PC0 (MCU input)
IO_LOC "ctl30"    30; IO_PORT "ctl30"    IO_TYPE=LVCMOS33 PULL_MODE=KEEPER PCI_CLAMP=OFF;             // [?] an input; PC6 does not reach it; source unknown; not used by this core
// Not used: 14 15 31 32 33 and the whole top row (3-11, 13, 48: configuration and JTAG pins).
